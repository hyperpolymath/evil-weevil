#
# STATE.a2ml — Project state checkpoint
#
# This is the STATE file for evil-weevil itself.

[metadata]
project = "evil-weevil"
version = "0.1.0"
last-updated = "2026-09-20"
# status: active | paused | archived | planned
#   planned — the repo is RESERVED but has not started (minted as a placeholder;
#             equivalent to CLADE [status] phase = "reserved"). It is NOT
#             "paused": paused reads as "was active, stopped".
# AUTHORITY: when this and CLADE [status] phase disagree, CLADE phase is the
# authoritative SCM checkpoint and STATE must be re-derived from it — never
# hand-edit both into agreement (standards#726).
status = "active"

[project-context]
name = "Evil Weevil"
purpose = "A universally injectable enemy-intelligence kernel for computer games: a host-agnostic, deterministic AI core behind an Idris2-verified C ABI over a Zig zero-overhead FFI seam, so enemy behaviour is authored once and injected into whatever engine the game already uses."
# Phase 1 (the seam) is complete and mechanically enforced: the ABI header is
# generated from a proved model, both null hosts agree on three pinned digests,
# and `just seam-check` fails if any of that stops being true. Phase 2 has landed
# its first half: perception and memory are specified, proved, implemented and
# pinned — an agent that loses a contact investigates where it went, for at most
# memory_ttl ticks, then forgets. Still to come inside Phase 2: the
# utility/behaviour graph, steering. This number counts working behaviour, not
# scaffolding and not specifications.
completion-percentage = 15

[position]
phase = "implementation"   # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[route-to-mvp]
milestones = [
  { name = "Phase 0: identity — minted from rsr-template-repo, drift repaired, clade chosen, gates green", completion = 100 },
  { name = "Phase 1: the seam — ee.h v0, Idris2 layout/purity proofs, Zig FFI, null host, 10k-tick harness", completion = 100 },
  { name = "Phase 2: kernel v0 — perception/memory, utility + behaviour graph, steering, budget guard, golden replays", completion = 35 },  # memory done end to end (ADR-0009); utility graph and steering remain
  { name = "Phase 3: authoring — enemy definition schema (a2ml), compiler, workbench and replay inspector", completion = 0 },
  { name = "Phase 4: adapters — Godot 4, Unity, Unreal, WASM, each passing one conformance kit", completion = 0 },
  { name = "Phase 5: populations — squads and roles, spawn director, threat curve, crowd LOD", completion = 0 },
  { name = "Phase 6: adaptive behaviour — adversarial play, offline difficulty calibration", completion = 0 },
]

[blockers-and-issues]
# 1. RESOLVED 2026-09-20 — the ABI seam is frozen at 1.0, fingerprint 18276775.
#    include/evil_weevil/ee.h and src/interface/generated/ee_layout.zig are
#    generated from src/interface/Abi/Types.idr, gated by an Idris2 proof suite,
#    checked by the C compiler's _Static_asserts and by Zig's comptime asserts,
#    and exercised by two independent null hosts. `just abi-check` fails if either
#    committed artefact stops matching the model, which is what "frozen" now means
#    here. No behaviour code and no adapter may change the header without an ADR.
# 2. Upstream mint defects, measured on this repo's own mint (2026-09-20) and
#    documented in docs/developer/MINT-NOTES.adoc: (a) RSR_NON_INTERACTIVE=1
#    cannot complete a mint; (b) template self-descriptions survive substitution
#    (repaired here by hand — STATE, ECOSYSTEM, CLAUDE.md); (c) the SonarCloud
#    header comment keeps the template owner (same family as
#    metadatastician/first-post#11); (d) check-no-placeholders.sh dies silently
#    (status 1, no message) on a repo with no git remote, because `git config
#    --get` exits 1 under `set -e` — found in Phase 1, fixed here, carried
#    upstream in docs/developer/MINT-NOTES.adoc §5.
# 3. Registration in gv-clade-index is the OWNER's act, not an agent's, and has
#    not been done.
# 4. Phase 1 exit is honest rather than tidy: the v0 rule is naive (five branches
#    over health, ammo, contacts, range), `ee_init` takes budget_units from a stub,
#    and v0 consults no randomness at all. Each is deliberate and recorded in
#    ADR-0006 and the kernel header, not overlooked.
# 5. RESOLVED 2026-09-20 — nothing is quarantined: all ten Idris2 modules compile
#    (the four modules that define the ABI, gated from src/interface/Abi/, and six
#    under verification/proofs/idris2/, including the four template modules that had
#    been quarantined since the template's own ground-truthing). `just
#    proof-check-idris2` is the gate; `just abi-gate-self-test` proves the ABI gates
#    fail when the ABI is deliberately broken.

[critical-next-actions]
actions = [
  "Phase 2 — replace the five-branch rule with a utility/behaviour graph, keeping the three pinned digests: a changed policy MUST change them deliberately, in both hosts, with the reason written down",
  "Phase 2 — steering: turn the INVESTIGATE direction into a path (this is where a remembered POSITION may finally earn its keep, and where Abi.Memory's bearing choice gets revisited)",
  "Phase 2 — replace the five-branch rule with a utility/behaviour graph while keeping the pinned digest test: a changed policy MUST change that number, deliberately",
  "Phase 2 — age the memory properly, later: TTLs per contact class rather than the one 36-tick interval Abi.Memory currently pins",
  "File the upstream mint defects against rsr-template-repo (three now; MINT-NOTES.adoc §5-6)",
  "Ratify ADR-0004 (injection modes), ADR-0005 (ABI versioning and capability negotiation), ADR-0006 (determinism policy) before Phase 2 opens",
]

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "unknown"  # unknown | pass | warn | fail
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = ["RSR Framework"]
# Zero runtime dependencies is a design constraint, not an accident: the kernel
# must inject into a host that has nothing else installed. Provenance (the
# template it was minted from) lives in VARIANT.a2ml, not here.
depends-on = []
